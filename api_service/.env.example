# PostgreSQL
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD  # 密码
## 本地开发
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/deep_agents
LANGGRAPH_DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/deep_agents
## 服务器部署
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@postgres:5432/deep_agents
# LANGGRAPH_DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@postgres:5432/deep_agents
DATABASE_SCHEMA=platform  # fastapi记录表名
LANGGRAPH_SCHEMA=langgraph  # deepagent表名

# LLM
OPENAI_BASE_URL=https://your-llm-provider.example/v1
OPENAI_API_KEY=YOUR_UPSTREAM_LLM_KEY
OPENAI_MODEL=your-model-name

# LANGFUSE
# LANGFUSE_PUBLIC_KEY=pk-lf-your-project-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-project-secret-key
# LANGFUSE_BASE_URL=http://langfuse-web:3000

# 工作空间
WORKSPACE_DIR=E:/workspace
# WORKSPACE_DIR=/workspace/

# Skill 根目录；后台刷新时扫描其中每个包含 SKILL.md 的目录。
AGENT_SKILLS_DIR=./skills

# MCP认证密钥（与mcp一致）
MCP_AUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# 飞书应用
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
FEISHU_PLATFORM_API_KEY=YOUR_FEISHU_PLATFORM_API_KEY  # 生成后修改
FEISHU_INTERNAL_AUTH_SECRET=GENERATE_A_SECOND_LONG_RANDOM_SECRET  # 飞书认证密钥
FEISHU_AGENT_API_BASE_URL=http://127.0.0.1:8000/v1
## FEISHU_AGENT_API_BASE_URL=http://api:8000/v1  # 服务器部署

# fastapi后台账号密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# key测试账号密码
# TEST_PLATFORM_API_KEY=
# TEST_PLATFORM_BASE_URL=http://127.0.0.1:8000/v1
